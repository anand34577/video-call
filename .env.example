# Copy to .env and fill in before running the app (native binary or
# `docker compose up`).
#
# Config priority (highest wins):
#   1. A real environment variable (including Docker's `environment:` block)
#   2. This .env file
#   3. A value set on the admin "Settings" screen in the app itself
#   4. The built-in default
# Most settings below are also editable at runtime from Settings without
# touching this file or restarting — each is marked below with whether it
# takes effect immediately or needs a restart. A handful (Network & TLS,
# the database connection, JWT_SECRET) can *only* be set here/via the
# environment — the app needs them before it can even open its database or
# bind a socket to look anything else up.

# =============================================================================
# Required
# =============================================================================

# Secret used to sign session JWTs. Generate with:  openssl rand -hex 32
# Unset = an ephemeral secret is generated and every session is invalidated
# on every restart — fine for a quick trial, not for real use.
JWT_SECRET=

# The LAN (or VPN) IP other devices use to reach this machine. The SFU
# advertises this address in WebRTC ICE candidates — required for group
# calls to work when participants are on different network segments.
# Editable from Settings (Calling & Media); needs a restart to take effect.
EXTERNAL_IP=192.168.1.50

# =============================================================================
# Server & Logging
# =============================================================================

# "debug" | "info" | "warn" | "error" (default info).
# Editable from Settings (Server & Logging); takes effect immediately.
# LOG_LEVEL=info

# First-run admin account, created only when the database is empty. Has no
# effect afterward. If the password is empty, a random one is generated and
# printed once in the server logs.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# Storage & database
# =============================================================================
# All fixed at boot — the app needs these before it can open its database.

# Where the sqlite database and uploaded files live.
# DATA_DIR=./data

# Optional: use Postgres or MySQL instead of the built-in sqlite database.
# Leave empty to keep using sqlite (zero setup, stored in DATA_DIR).
#   postgres://user:pass@host:5432/dbname?sslmode=disable
#   mysql://user:pass@host:3306/dbname
DATABASE_URL=

# =============================================================================
# Calling & Media
# =============================================================================

# TURN relay (coturn service in docker-compose). host:port form.
# TURN_SECRET must match the coturn static-auth-secret — in this stack both
# read this same variable, so just set a long random value. Not required on
# a plain same-subnet LAN; needed for VPN meshes / multi-subnet / strict NAT.
# Both editable from Settings; take effect immediately.
TURN_HOST=192.168.1.50:3478
TURN_SECRET=

# Soft cap on conference call participants (default 8).
# Editable from Settings (Calling & Media); needs a restart to take effect.
MAX_CALL_PARTICIPANTS=8

# =============================================================================
# Files & Storage
# =============================================================================
# All three editable from Settings (Files & Storage); take effect immediately.

# Per-upload size limit in MB (default 50).
# MAX_FILE_MB=50

# Total upload storage allowed per user, in MB (default 2048). 0 = unlimited.
MAX_USER_STORAGE_MB=2048

# Comma-separated file extensions rejected on upload (default: common
# Windows/Unix executables and scripts). Set to "none" to allow everything.
# BLOCKED_FILE_EXTENSIONS=.exe,.bat,.cmd,.ps1,.sh

# =============================================================================
# Security & Sessions
# =============================================================================

# How long a login session lasts, in hours (default 12).
# Editable from Settings (Security & Sessions); takes effect immediately for
# new logins — sessions already issued keep their original expiry.
# SESSION_TTL_HOURS=12

# =============================================================================
# Email & Password Reset
# =============================================================================
# Optional: SMTP credentials to enable self-service "forgot password" email.
# Leave all unset to disable password-reset entirely (nothing else depends
# on this). SMTP_FROM defaults to SMTP_USER if unset. All editable from
# Settings (Email & Password Reset); take effect immediately.

# Master switch — turn the feature off without discarding the SMTP
# credentials below (default true; only matters once SMTP_HOST is also set).
# PASSWORD_RESET_ENABLED=true

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# The externally-visible origin used to build password-reset links and the
# OIDC callback URL (e.g. https://videocall.example.lan:8443). Required for
# password-reset emails: without it, "forgot password" stays disabled, since
# building the link from the incoming request's Host header would let an
# attacker who controls that header point the emailed link at their own
# domain. Takes effect immediately.
# PUBLIC_BASE_URL=

# =============================================================================
# Single Sign-On (SSO)
# =============================================================================
# Optional: SSO login via any OpenID Connect provider (Keycloak, Authentik,
# Entra ID, Okta, Google Workspace, ...). Entirely optional and inert unless
# OIDC_ISSUER_URL is set — the rest of the app has zero dependency on it, and
# a briefly-unreachable IdP degrades only SSO login, not the app.
# All editable from Settings (Single Sign-On); ENABLED/AUTO_CREATE_USERS/
# BUTTON_LABEL take effect immediately, the other four need a restart.
# ISSUER_URL/CLIENT_ID/CLIENT_SECRET/REDIRECT_URL are required together once
# ISSUER_URL is set (REDIRECT_URL can be omitted if PUBLIC_BASE_URL is set).

# Master switch — turn SSO off without discarding the configuration below.
# OIDC_ENABLED=true

# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# OIDC_AUTO_CREATE_USERS=false
# OIDC_BUTTON_LABEL=Sign in with SSO

# =============================================================================
# Network & TLS
# =============================================================================
# All fixed at boot — these bind a socket or load a certificate file before
# there's even a running server to edit them from, so none of this section
# is editable from the Settings screen; change here, then restart.

# How the app handles HTTP vs HTTPS (see README "HTTP vs HTTPS" section for
# the four supported setups). Defaults: self-signed HTTPS on LISTEN_ADDR
# (:8443) plus a plain-HTTP companion on HTTP_ADDR (:8080) that also serves
# the app. Uncomment to change that:
# LISTEN_ADDR=:8443
# HTTP_ADDR=:8080
# DISABLE_TLS=true          # plain HTTP only, no cert at all
# HTTPS_REDIRECT=true       # HTTP_ADDR redirects to HTTPS instead of also serving it

# Your own certificate — unset means a self-signed one is generated
# automatically (and regenerated if the machine's network addresses change
# or it's within 30 days of expiring).
# TLS_CERT=
# TLS_KEY=

# Set these only when a trusted reverse proxy is in front of the app.
# TRUST_PROXY enables X-Forwarded-For / X-Real-IP / X-Forwarded-Proto
# handling. PROXY_TLS marks the session cookie Secure when TLS terminates at
# that proxy. Unlike the rest of this section, both are ALSO editable live
# from Settings once not pinned here — a restart is only needed if changing
# TRUST_PROXY should also change whether this process binds its own TLS
# listener.
TRUST_PROXY=false
PROXY_TLS=false
