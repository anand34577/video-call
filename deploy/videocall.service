[Unit]
Description=Vision Call (self-hosted chat and video calling)
After=network-online.target
Wants=network-online.target

[Service]
# Installed by scripts/install-linux.sh, which creates the videocall user and
# /opt/videocall/{videocall,.env,data}. The app reads /opt/videocall/.env
# itself because it runs from that directory.
Type=simple
User=videocall
Group=videocall
WorkingDirectory=/opt/videocall
ExecStart=/opt/videocall/videocall
Restart=on-failure
RestartSec=3

# Basic sandboxing: the app only needs to read/write its own data dir and
# bind its listen port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/videocall/data
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
