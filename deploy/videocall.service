[Unit]
Description=Vision Call (self-hosted LAN chat + video calling)
After=network-online.target
Wants=network-online.target

[Service]
# Installed by scripts/install-linux.sh (creates the videocall user,
# /opt/videocall/{videocall,.env,data}); see README "Running as a service".
Type=simple
User=videocall
Group=videocall
WorkingDirectory=/opt/videocall
EnvironmentFile=/opt/videocall/.env
ExecStart=/opt/videocall/videocall -addr :8443
Restart=on-failure
RestartSec=3

# Basic sandboxing: the app only needs to read/write its own data dir and
# bind its listen port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/videocall/data
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
