[Unit]
Description=Vision Call (self-hosted chat and video calling)
After=network-online.target
Wants=network-online.target

[Service]
# Installed by scripts/install-linux.sh, which creates the visioncall user and
# /opt/visioncall/{visioncall,.env,data}. The app reads /opt/visioncall/.env
# itself because it runs from that directory.
Type=simple
User=visioncall
Group=visioncall
WorkingDirectory=/opt/visioncall
ExecStart=/opt/visioncall/visioncall
Restart=on-failure
RestartSec=3

# Basic sandboxing: the app only needs to read/write its own data dir and
# bind its listen port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/visioncall/data
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
