[Unit]
Description=Run Vision Call's daily database backup

[Timer]
OnCalendar=*-*-* 03:00:00
# Catch up on the next boot if the machine was off at 03:00 (common on a
# home/office LAN box that gets turned off overnight) instead of silently
# skipping a day's backup.
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
