[Unit]
Description=Vision Call daily database backup
# Don't fight the main service for the sqlite file at the exact moment it
# starts or restarts. The backup only reads a snapshot of the database, so the
# server keeps running normally throughout.
After=videocall.service

[Service]
Type=oneshot
User=videocall
Group=videocall
WorkingDirectory=/opt/videocall
# Installed by scripts/install-linux.sh. Backups land in
# /opt/videocall/data/backups and are kept for 14 days.
ExecStart=/opt/videocall/deploy/backup.sh

# Same sandboxing as videocall.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/videocall/data
