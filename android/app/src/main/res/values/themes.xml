<resources>
    <!-- Dark window/splash so launch never flashes white; Compose draws the real theme. -->
    <style name="Theme.VisionCall" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vc_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31" xmlns:tools="http://schemas.android.com/tools">@color/vc_splash</item>
    </style>
    <color name="vc_splash">#0B0E14</color>
</resources>
